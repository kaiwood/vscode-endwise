{
  "name": "endwise",
  "displayName": "endwise",
  "description": "Wisely add closing keywords in Ruby, Crystal, Elixir, Julia, Lua, Makefiles, and shell scripts.",
  "version": "2.0.0",
  "preview": false,
  "publisher": "kaiwood",
  "license": "MIT",
  "icon": "images/icon.png",
  "bugs": "https://github.com/kaiwood/vscode-endwise/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiwood/vscode-endwise"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:crystal",
    "onLanguage:elixir",
    "onLanguage:julia",
    "onLanguage:lua",
    "onLanguage:makefile",
    "onLanguage:shellscript"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "title": "Endwise",
      "properties": {
        "endwise.languages.ruby.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Ruby."
        },
        "endwise.languages.crystal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Crystal."
        },
        "endwise.languages.elixir.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Elixir."
        },
        "endwise.languages.julia.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Julia."
        },
        "endwise.languages.lua.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Lua."
        },
        "endwise.languages.makefile.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Makefiles."
        },
        "endwise.languages.shellscript.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for shell scripts."
        }
      }
    },
    "keybindings": [
      {
        "command": "endwise.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId =~ /^ruby$|^crystal$|^elixir$|^julia$|^lua$|^makefile$|^shellscript$/ && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode && !editorReadonly"
      },
      {
        "command": "endwise.cmdEnter",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId =~ /^ruby$|^crystal$|^elixir$|^julia$|^lua$|^makefile$|^shellscript$/"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint .",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.4",
    "mocha": "^11.7.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5"
  }
}
