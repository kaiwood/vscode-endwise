{
  "name": "endwise",
  "displayName": "endwise",
  "description": "Wisely add \"end\" in Ruby.",
  "version": "1.5.1",
  "preview": false,
  "publisher": "kaiwood",
  "license": "MIT",
  "icon": "images/icon.png",
  "bugs": "https://github.com/kaiwood/vscode-endwise/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiwood/vscode-endwise"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:crystal"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "title": "Endwise",
      "properties": {
        "endwise.languages.ruby.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Ruby."
        },
        "endwise.languages.crystal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Endwise behavior for Crystal."
        }
      }
    },
    "keybindings": [
      {
        "command": "endwise.cmdEnter",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId =~ /^ruby$|^crystal$/ && vim.mode != 'Normal' && vim.mode != 'SearchInProgressMode' && vim.mode != 'CommandlineInProgress^' "
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint .",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.4",
    "mocha": "^11.7.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5"
  }
}
